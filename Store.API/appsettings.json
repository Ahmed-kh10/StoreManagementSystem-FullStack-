{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=StoreDb_V2;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "Issuer": "StoreManager",
    "Audience": "StoreManagerClient",
    "DurationInMinutes": 60
  },

  "StripeSettings": {
    "PublishableKey": ""
  }
}